# Quarto
/.quarto/
/_freeze/
*_files/
*.html

# Hand-authored HTML assets (not Quarto render output) — exceptions to *.html above.
# Quarto only writes index.html at each lecture's root, never under media/,
# so any HTML in a lecture's media/ tree is a hand-written interactive.
!lectures/*/media/**/*.html
# ...and the unbundled interactive sources they're built from
# (scripts/bundle_interactive.py: code/interactive/ -> media/interactive/).
!lectures/*/code/**/*.html
# ...and shared hand-written HTML snippets (e.g. deck include-after-body files).
!assets/html/*.html

# Jupyter / Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# OS
.DS_Store
